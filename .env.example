# Copy to .env and adjust. Never commit .env (AGENTS.md §10: secrets are injected).

# Django
RALLY_SECRET_KEY=dev-only-not-a-secret-change-me
RALLY_DEBUG=1
RALLY_ALLOWED_HOSTS=127.0.0.1,localhost

# One display time zone for the pilot; every timestamp is stored UTC (AGENTS.md §5, G-11)
RALLY_TIME_ZONE=Asia/Karachi

# PostgreSQL (docker-compose.yml provides these defaults locally)
RALLY_DB_NAME=rally
RALLY_DB_USER=rally
RALLY_DB_PASSWORD=rally
RALLY_DB_HOST=127.0.0.1
RALLY_DB_PORT=5432

# Cookies: set to 1 behind HTTPS (ADR-008 S-05)
RALLY_SECURE_COOKIES=0
