# import-linter contracts (AGENTS.md section 1, rules 1, 2, 3, 9, 12; ADR-007).
#
# A contract names only packages that exist: import-linter aborts the whole run on an
# unknown module, so the slice that creates a module adds it to the lists below.
# Built so far: rally.core (P), rally.modules.identity (M1), rally.modules.notification (M7).
#
# Run with:  lint-imports

[importlinter]
root_packages =
    rally
include_external_packages = False

[importlinter:contract:platform-uses-facades-only]
name = Platform may import a module's api, never its internals or its model shim
type = forbidden
# Rule 2 is about the import a file writes down. A facade reaching its own internals is
# the whole point of a facade, so indirect chains through it are not a violation.
allow_indirect_imports = true
source_modules =
    rally.core
forbidden_modules =
    rally.modules.identity.internal
    rally.modules.identity.models
    rally.modules.notification.internal
    rally.modules.notification.models

[importlinter:contract:modules-do-not-import-the-web-layer]
name = A capability module never imports Platform's web layer
type = forbidden
source_modules =
    rally.modules.identity
    rally.modules.notification
forbidden_modules =
    rally.core.web

[importlinter:contract:settings-are-not-a-module-dependency]
name = No capability module imports the project settings or the root URL conf
type = forbidden
source_modules =
    rally.modules.identity
forbidden_modules =
    rally.settings
    rally.urls
    rally.wsgi

[importlinter:contract:nothing-imports-notification]
name = No business module imports M7 (rule 3); Platform's OutboxAppender port is the only way in
type = forbidden
# Direct imports only, and that is the whole rule: a business module writes down
# `rally.core.ports.outbox` and never `rally.modules.notification`. The indirect chain
# M1 -> port -> wiring registry -> M7 is the port doing its job (rule 15); forbidding it
# would forbid having a port at all.
allow_indirect_imports = true
source_modules =
    rally.modules.identity
forbidden_modules =
    rally.modules.notification

[importlinter:contract:notification-reaches-m1-through-its-facade-only]
name = M7 reads the delivery address through M1's facade, never its internals (rule 2)
type = forbidden
allow_indirect_imports = true
source_modules =
    rally.modules.notification
forbidden_modules =
    rally.modules.identity.internal
    rally.modules.identity.models

[importlinter:contract:profile-reads-m1-only-through-its-published-view]
name = M2 Profile does not import M1 at all; it reads v_verified_account (AGENTS.md section 3)
type = forbidden
# The allowlist grants `profile -> identity` as a read of one published view, not as a
# call. M2's production packages are therefore named one by one: none of them may import
# M1, and `internal/verification.py` queries the view instead. `rally.modules.profiles.tests`
# is deliberately outside the contract - a test needs M1's facade to create the account a
# profile belongs to, and that is fixture setup, not a production dependency.
source_modules =
    rally.modules.profiles.api
    rally.modules.profiles.internal
    rally.modules.profiles.views
    rally.modules.profiles.models
forbidden_modules =
    rally.modules.identity
    rally.modules.notification
    rally.core.web

[importlinter:contract:availability-depends-on-nothing]
name = M3 Availability depends on no other capability module (AGENTS.md section 3)
type = forbidden
source_modules =
    rally.modules.availability
forbidden_modules =
    rally.modules.identity
    rally.modules.profiles
    rally.modules.notification
    rally.core.web
