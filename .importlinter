# import-linter contracts (AGENTS.md section 1, rules 1, 2, 3, 9, 12; ADR-007).
#
# A contract names only packages that exist: import-linter aborts the whole run on an
# unknown module, so the slice that creates a module adds it to the lists below.
# Built so far: every module, M1 to M8 and Platform.
#
# Run with:  lint-imports

[importlinter]
root_packages =
    rally
include_external_packages = False

[importlinter:contract:platform-uses-facades-only]
name = Platform may import a module's api, never its internals or its model shim
type = forbidden
# Rule 2 is about the import a file writes down. A facade reaching its own internals is
# the whole point of a facade, so indirect chains through it are not a violation.
allow_indirect_imports = true
source_modules =
    rally.core
forbidden_modules =
    rally.modules.identity.internal
    rally.modules.identity.models
    rally.modules.notification.internal
    rally.modules.notification.models
    rally.modules.safety.internal
    rally.modules.safety.models
    rally.modules.player_collections.internal
    rally.modules.player_collections.models

[importlinter:contract:modules-do-not-import-the-web-layer]
name = A capability module never imports Platform's web layer
type = forbidden
source_modules =
    rally.modules.identity
    rally.modules.notification
forbidden_modules =
    rally.core.web

[importlinter:contract:settings-are-not-a-module-dependency]
name = No capability module imports the project settings or the root URL conf
type = forbidden
source_modules =
    rally.modules.identity
    rally.modules.safety
    rally.modules.invitations
forbidden_modules =
    rally.settings
    rally.urls
    rally.wsgi

[importlinter:contract:nothing-imports-notification]
name = No business module imports M7 (rule 3); Platform's OutboxAppender port is the only way in
type = forbidden
# Direct imports only, and that is the whole rule: a business module writes down
# `rally.core.ports.outbox` and never `rally.modules.notification`. The indirect chain
# M1 -> port -> wiring registry -> M7 is the port doing its job (rule 15); forbidding it
# would forbid having a port at all.
allow_indirect_imports = true
source_modules =
    rally.modules.identity
    rally.modules.safety
forbidden_modules =
    rally.modules.notification

[importlinter:contract:notification-reaches-m1-through-its-facade-only]
name = M7 reads the delivery address through M1's facade, never its internals (rule 2)
type = forbidden
allow_indirect_imports = true
source_modules =
    rally.modules.notification
forbidden_modules =
    rally.modules.identity.internal
    rally.modules.identity.models

[importlinter:contract:profile-reads-m1-only-through-its-published-view]
name = M2 Profile does not import M1 at all; it reads v_verified_account (AGENTS.md section 3)
type = forbidden
# The allowlist grants `profile -> identity` as a read of one published view, not as a
# call. M2's production packages are therefore named one by one: none of them may import
# M1, and `internal/verification.py` queries the view instead. `rally.modules.profiles.tests`
# is deliberately outside the contract - a test needs M1's facade to create the account a
# profile belongs to, and that is fixture setup, not a production dependency.
source_modules =
    rally.modules.profiles.api
    rally.modules.profiles.internal
    rally.modules.profiles.views
    rally.modules.profiles.models
forbidden_modules =
    rally.modules.identity
    rally.modules.notification
    rally.core.web

[importlinter:contract:availability-depends-on-nothing]
name = M3 Availability depends on no other capability module (AGENTS.md section 3)
type = forbidden
source_modules =
    rally.modules.availability
forbidden_modules =
    rally.modules.identity
    rally.modules.profiles
    rally.modules.notification
    rally.core.web

[importlinter:contract:safety-depends-on-nothing]
name = M6 Safety depends on no other capability module, M5 least of all (AGENTS.md section 3, rule 15)
type = forbidden
# This is the contract plan.md S12 AC5 asks for. `rally.modules.invitations` is in the
# forbidden list because the block cascade is the one place tempted to import it: M6
# declares the `PendingInvitationCanceller` port, M5 implements it, and Platform binds
# them at startup. Indirect chains are allowed for exactly that reason - M6 -> port ->
# wiring registry -> M5 is the port doing its job (ADR-007 R-02); forbidding it would
# forbid having a port at all. What must never appear is a direct import, and that is
# what this checks.
allow_indirect_imports = true
source_modules =
    rally.modules.safety.api
    rally.modules.safety.internal
    rally.modules.safety.views
    rally.modules.safety.models
forbidden_modules =
    rally.modules.identity
    rally.modules.profiles
    rally.modules.availability
    rally.modules.search
    rally.modules.invitations
    rally.modules.notification
    rally.core.web

[importlinter:contract:search-reads-views-and-is-called-by-nobody]
name = M4 imports no other module and no module imports M4 (rules 1, 9)
type = forbidden
source_modules =
    rally.modules.search.api
    rally.modules.search.internal
    rally.modules.search.views
forbidden_modules =
    rally.modules.identity
    rally.modules.profiles
    rally.modules.availability
    rally.modules.safety
    rally.modules.notification
    rally.core.web

[importlinter:contract:collections-read-views-only]
name = M8 imports no other capability module; it reads published views (rules 1, 11, 12)
type = forbidden
# M8's display is composed from `v_searchable_profile`, `v_active_availability` and
# `v_block_pairs` in SQL, so it needs no import of M2, M3 or M6 at all - which is why
# they are forbidden here rather than merely restricted to their facades. M4 is
# forbidden in both directions: M8 does not execute a search and M4 does not read M8
# (rule 12, architecture section 16.6).
source_modules =
    rally.modules.player_collections.api
    rally.modules.player_collections.internal
    rally.modules.player_collections.views
    rally.modules.player_collections.models
forbidden_modules =
    rally.modules.identity
    rally.modules.profiles
    rally.modules.availability
    rally.modules.search
    rally.modules.invitations
    rally.modules.safety
    rally.modules.notification
    rally.core.web
    rally.settings
    rally.urls

[importlinter:contract:nothing-imports-collections]
name = Nothing depends on M8; it is a leaf (AGENTS.md section 3)
type = forbidden
source_modules =
    rally.modules.identity
    rally.modules.profiles
    rally.modules.availability
    rally.modules.search
    rally.modules.invitations
    rally.modules.safety
    rally.modules.notification
forbidden_modules =
    rally.modules.player_collections

[importlinter:contract:nothing-imports-search]
name = Only Platform calls M4; no capability module imports it (rule 9)
type = forbidden
source_modules =
    rally.modules.identity
    rally.modules.profiles
    rally.modules.availability
    rally.modules.safety
    rally.modules.notification
forbidden_modules =
    rally.modules.search

[importlinter:contract:invitations-depend-on-three-modules-only]
name = M5 imports M2, M3 and M6 only, and never M1 or M7 (AGENTS.md section 3, rule 3)
type = forbidden
allow_indirect_imports = true
source_modules =
    rally.modules.invitations.api
    rally.modules.invitations.internal
    rally.modules.invitations.views
    rally.modules.invitations.models
forbidden_modules =
    rally.modules.identity
    rally.modules.notification
    rally.modules.search
    rally.core.web

[importlinter:contract:invitations-use-facades-only]
name = M5 reaches M2, M3 and M6 through their facades, never their internals (rule 2)
type = forbidden
allow_indirect_imports = true
source_modules =
    rally.modules.invitations
forbidden_modules =
    rally.modules.profiles.internal
    rally.modules.profiles.models
    rally.modules.availability.internal
    rally.modules.availability.models
    rally.modules.safety.internal
    rally.modules.safety.models
    rally.modules.player_collections.internal
    rally.modules.player_collections.models
